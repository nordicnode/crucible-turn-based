{
  "name": "crucible-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "wasm": "bash ../scripts/build-wasm.sh",
    "build": "npm run wasm && tsc -b && vite build",
    "build:js": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:terrain": "esbuild terrain-preview-entry.ts --bundle --format=iife --outfile=terrain-preview-bundle.js && node build-terrain-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
